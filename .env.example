# ============================================================
# Variables de Entorno — AquaPlants (Configuración y Seguridad)
# ============================================================

# Modo Depuración (DEBUG)
# En producción SIEMPRE debe ser False. Para desarrollo local se puede usar True.
DEBUG=False

# Clave Secreta de Django (SECRET_KEY)
# En producción genere una clave criptográficamente segura (ej: django-admin get_random_secret_key).
# Si no se define en producción se emitirá una advertencia de seguridad.
SECRET_KEY=django-insecure-+p#cpiotzzi(wd=zpz8&4-vf_2851+_&ma445x%+gln)!s2yi&

# Hosts Permitidos (ALLOWED_HOSTS)
# Lista de dominios/IPs separados por comas autorizados a servir la aplicación.
# Se eliminó el comodín '*' por razones de seguridad.
# Fallback por defecto: 127.0.0.1, localhost, testserver, .pythonanywhere.com
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,.pythonanywhere.com

# Configuración CORS (Cross-Origin Resource Sharing)
# CORS_ALLOW_ALL_ORIGINS: Por defecto False. Solo activar temporalmente para pruebas abiertas.
CORS_ALLOW_ALL_ORIGINS=False

# Orígenes CORS permitidos (separados por comas) cuando CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://fabianvidal.pythonanywhere.com

# Credenciales de Autenticación para Dispositivo IoT / AquaBrain
# Utilizadas por 'python manage.py setup_roles' y por 'simulador_iot.py'
AQUA_IOT_USER=iot_device
AQUA_IOT_PASSWORD=AquaSecret2026!

# URL base para el simulador IoT (opcional)
AQUA_URL=http://127.0.0.1:8000

# Motor de Base de Datos:
# En PythonAnywhere (gratis): usa 'sqlite'
# En local (con XAMPP/MariaDB/HeidiSQL): usa 'mysql'
DB_ENGINE=sqlite

# Solo necesarios si DB_ENGINE=mysql:
DB_NAME=aquaplants_db
DB_USER=root
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=3306
